# Copia este archivo como deploy/.env en el servidor y completa los valores.
# No subas deploy/.env al repositorio.

# Dominio sin www ni https, por ejemplo libreriadenver.pe
DOMINIO=

# Claves largas al azar. Generalas con: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=

# Correos (Gmail con contraseña de aplicación).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=libreriadenver@gmail.com
SMTP_PASS=
SMTP_FROM="DENVER Librería <libreriadenver@gmail.com>"
CORREO_TIENDA=libreriadenver@gmail.com

# Se completa con deploy/clave-tienda.sh despues del primer arranque.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
